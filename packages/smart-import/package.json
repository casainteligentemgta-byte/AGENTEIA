{
  "name": "@agenteia/smart-import",
  "version": "0.1.0",
  "private": true,
  "description": "SmartImport — production-ready (F1–F6)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/__tests__/unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage src/__tests__/unit",
    "coverage": "vitest run --coverage src/__tests__/unit",
    "test:performance": "vitest run src/__tests__/performance",
    "test:resilience": "vitest run src/__tests__/resilience",
    "test:observability": "vitest run src/__tests__/observability",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:load": "k6 run load-test/import.load.js",
    "test:load:smoke": "SCENARIO=smoke k6 run load-test/import.load.js",
    "test:load:cloud": "k6 cloud load-test/import.load.js",
    "test:chaos": "vitest run chaos-test",
    "test:security": "vitest run src/__tests__/security",
    "test:contract": "vitest run src/__tests__/contract",
    "test:integration": "vitest run src/__tests__/integration",
    "test:all": "npm run test && npm run test:e2e && npm run test:chaos && npm run test:security && npm run test:contract && npm run test:integration",
    "dev": "tsx src/api/server.ts",
    "dev:e2e": "tsx e2e/server.ts",
    "start": "node dist/api/server.js",
    "docker:build": "docker build -t smartimport:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "k8s:apply": "kubectl apply -f k8s/00-namespace.yaml -f k8s/01-configmap.yaml -f k8s/10-redis.yaml -f k8s/20-app.yaml",
    "k8s:status": "kubectl -n production get pods,svc,hpa"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-jaeger": "^2.10.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@sentry/node": "^10.71.0",
    "@supabase/supabase-js": "^2.49.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "fast-xml-parser": "^4.5.1",
    "ioredis": "^5.11.1",
    "papaparse": "^5.7.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^6.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^2.1.9",
    "jest-html-reporters": "^3.1.7",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
