{
  "name": "@agenteia/smart-import",
  "version": "0.1.0",
  "private": true,
  "description": "SmartImport — seguridad (F1) + caché (F2) + resiliencia (F3)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/__tests__/unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage src/__tests__/unit",
    "test:performance": "vitest run src/__tests__/performance",
    "test:resilience": "vitest run src/__tests__/resilience",
    "dev": "tsx src/api/server.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "fast-xml-parser": "^4.5.1",
    "ioredis": "^5.11.1",
    "papaparse": "^5.7.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^6.2.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
