{
  "name": "@agenteia/smart-import",
  "version": "0.1.0",
  "private": true,
  "description": "SmartImport — importación segura de datos (Fase 1: validación, rate limit, auth)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
