# Copiar a .env y completar. No commitear secretos.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Supabase Auth + data
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Redis (caché / rate-limit)
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Postgres (compose local — health check usa DATABASE_URL si no hay Supabase)
POSTGRES_PASSWORD=smartimport_dev_change_me
DATABASE_URL=postgresql://smartimport:smartimport_dev_change_me@127.0.0.1:5432/smartimport

# Observabilidad
HEALTH_MONITOR=1
DISABLE_SWAGGER=0
OTEL_ENABLED=0
GF_SECURITY_ADMIN_PASSWORD=admin

# Imagen prod
# SMARTIMPORT_IMAGE=ghcr.io/casainteligentemgta-byte/smartimport:latest
