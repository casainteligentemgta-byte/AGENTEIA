# SmartImport — plantilla de entorno (copiar a .env y completar)
# Nunca commits de .env con secretos reales.

# App
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Auth / seguridad
JWT_SECRET=change-me-in-production-use-long-random-string
# RATE_LIMIT_USE_REDIS=1

# Base de datos (Postgres)
DATABASE_URL=postgresql://smartimport:YOUR_DB_PASS@localhost:5432/smartimport
# POSTGRES_USER=smartimport
# POSTGRES_PASSWORD=replace-me
# POSTGRES_DB=smartimport

# Redis
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# Observabilidad / CORS
CORS_ORIGIN=http://localhost:3000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# PROMETHEUS_PORT=9090

# Grafana (solo docker-compose local)
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin

# Opcionales
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CACHE_TTL_SECONDS=3600
# LLM_PROVIDER=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
