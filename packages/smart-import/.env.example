# Copiar a .env y completar. No commitear secretos reales.
# cp .env.example .env

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Auth JWT (Supabase JWT secret / signing key de tu proyecto — rellenar en .env)
JWT_SECRET=YOUR_JWT_SECRET_CHANGE_ME

# Supabase Auth + data
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Redis (caché / rate-limit)
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=  # opcional; definir solo en .env local

# Postgres (compose local — health check usa DATABASE_URL si no hay Supabase)
# POSTGRES_PASSWORD=  # definir en .env (compose) — no poner valor aquí
DATABASE_URL=postgresql://smartimport:YOUR_DB_PASSWORD@127.0.0.1:5432/smartimport

# Observabilidad
HEALTH_MONITOR=1
DISABLE_SWAGGER=0
OTEL_ENABLED=0
# GF_SECURITY_ADMIN_PASSWORD=  # Grafana; definir en .env

# Imagen prod
# SMARTIMPORT_IMAGE=ghcr.io/YOUR_ORG/smartimport:latest
