# Puerto Libre — Importación (app independiente de SmartTaller)
# Copia a .env.local y rellena los valores.
# Mismo proyecto Supabase que SmartTaller (tablas vehiculos, importadores, RLS).

# Supabase — Auth + servidor
# Copiar SIN viñetas ni espacios extra. Debe empezar por eyJ
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de ESTA app (dominio Vercel o custom)
NEXT_PUBLIC_APP_URL=http://localhost:3004

# IA — OCR de facturas, cédulas, improntas y carga masiva
# Si GEMINI_API_KEY está definida, tiene prioridad sobre OPENAI_API_KEY.
GEMINI_API_KEY=
OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# LLM_MONTHLY_BUDGET_USD=5

# Cron Vercel — alertas de nacionalización y seguro
CRON_SECRET=tu-secreto-cron-123

# Email — Resend (alertas de vencimiento)
# RESEND_API_KEY=re_...
# RESEND_FROM=Puerto Libre <alertas@tu-dominio.com>
