# Copia a .env.local y rellena. No commitear .env.local

NEXT_PUBLIC_AGENT_NAME=Cientifico Loco

# Chat + embeddings.
# Producción (Vercel): OpenRouter (sk-or-v1-...) en OPENAI_API_KEY.
# Local: la misma clave de OpenRouter, o OpenAI directo (sk-proj-...).
OPENAI_API_KEY=

# Búsqueda web (opcional). Sin esta clave el chat NO se rompe:
# webSearch responde que no está configurada y el agente sigue.
# https://serper.dev — 2500 búsquedas gratis. Añadir también en Vercel.
SERPER_API_KEY=

# Alternativa a Serper (solo se usa si no hay SERPER_API_KEY)
# TAVILY_API_KEY=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: seed de memorias de sistema (`npm run seed:memory`)
# SUPABASE_SERVICE_ROLE_KEY=

# Auth obligatoria por defecto (login para / y /agente).
# false solo en desarrollo local si quieres ver la UI sin sesión.
# /api/chat SIEMPRE exige sesión, aunque esto esté en false.
NEXT_PUBLIC_REQUIRE_AUTH=true

# Tope diario de mensajes por usuario en /api/chat (UTC). 0 = ilimitado.
CHAT_DAILY_MESSAGE_LIMIT=50

# createFile escribe al filesystem (no persiste en Vercel).
# En production está desactivada. true solo en local o si sabes lo que haces.
# ENABLE_CREATE_FILE=false

# URL pública (OpenRouter Referer en producción)
NEXT_PUBLIC_SITE_URL=https://web-sand-ten-60.vercel.app

# Red con proxy/UniFi (solo dev local):
#   npm run dev:local
#   npm run seed:memory:local

# --- Ojo de Dios (panel personal en /agente/ojo-de-dios) ---
# Apagado por defecto, también en development. En producción déjalo false o sin definir.
OJO_DE_DIOS_ENABLED=false

# Dueño del panel privado. Sin esto, Gmail/Garmin nunca usan tokens de entorno
# (evita mostrar salud/correo de Luis a otro usuario autenticado).
# OJO_DE_DIOS_OWNER_EMAIL=
# OJO_DE_DIOS_OWNER_USER_ID=

# Gmail solo lectura. Nunca se responde ni se marca leído. Sin estos valores: «No conectado».
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Garmin Wellness API (proveedor autorizado). No uses email/contraseña de Garmin Connect.
# GARMIN_ACCESS_TOKEN=

# Tendencias de X. Sin bearer la tarjeta no se muestra.
# X_BEARER_TOKEN=
