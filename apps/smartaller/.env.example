# SmartTaller — gestión de mantenimientos vía Telegram
# Copia a .env.local y rellena los valores.

# Telegram Bot (crear con @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=mi-secreto-123

# IA — visión (placa, tablero, facturas) + chat
# Opción gratis (recomendada): Google AI Studio → https://aistudio.google.com/apikey
# Si GEMINI_API_KEY está definida, tiene prioridad sobre OPENAI_API_KEY.
GEMINI_API_KEY=
# Alternativa de pago: OpenAI (sk-proj-...) u OpenRouter (sk-or-v1-...)
OPENAI_API_KEY=sk-...
# Modelos Gemini opcionales (default: gemini-2.0-flash)
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash

# Supabase — Auth (login/dashboard) + servidor (webhook)
# Copiar SIN viñetas ni espacios extra. Debe empezar por eyJ
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# WhatsApp — producción: Twilio (pendiente de integrar)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp pruebas: CallMeBot (solo envía al número que activó la key)
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=

# URL pública (links al portal cliente, OpenRouter, Stripe)
NEXT_PUBLIC_APP_URL=https://smarttaller.xyz

# Cron Vercel — recordatorios automáticos (generar string aleatorio)
CRON_SECRET=tu-secreto-cron-123

# Stripe — suscripción SmartTaller Pro ($2.99/mes)
# Guía completa: docs/STRIPE-SETUP.md
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Modelos opcionales (OpenRouter usa prefijo openai/, ej. openai/gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=openai/gpt-4o-mini

# Tope mensual estimado de gasto IA en USD (opcional). Si se supera, bloquea OCR/chat.
# LLM_MONTHLY_BUDGET_USD=5

# Panel presidencia (recepción) — opcional; si no se define, el kiosk es público por URL
PRESIDENCIA_PIN=

# Email — Resend (https://resend.com)
# RESEND_API_KEY=re_...
# Remitente verificado (DNS en notificaciones.smarttaller.xyz o dominio acordado)
# RESEND_FROM=SmartTaller Alertas <alertas@notificaciones.smarttaller.xyz>

# SmartBike — webhook ficticio Strava (header x-strava-webhook-secret)
STRAVA_WEBHOOK_SECRET=mi-secreto-strava-123
